{
  "name": "rocks-hero-tools",
  "private": true,
  "description": "Ferramentas de desenvolvimento do app Rocks Hero (dados, bundle do Firebase, logo e testes). O app em si não depende de nada daqui.",
  "type": "module",
  "scripts": {
    "data:fetch": "node data/fetch-wikitext.mjs",
    "data:build": "node data/build-data.mjs && node data/build-meta.mjs && node data/validate.mjs",
    "data:validate": "node data/validate.mjs",
    "firebase:bundle": "node firebase-bundle/build.mjs",
    "emulators": "npx -y firebase-tools@15.30.1 emulators:start --only auth,database --project demo-rockshero --config ../firebase.json",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:rules": "node tests/rules/rules.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "opentype.js": "2.0.0",
    "puppeteer-core": "25.11.0"
  }
}
